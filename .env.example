# Site identity (optional in development; set before launch)
NEXT_PUBLIC_SITE_NAME=Financial Figure
NEXT_PUBLIC_SITE_URL=https://financialfigure.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@financialfigure.com

# Monetisation & analytics (leave blank to disable). See CHECKLIST.md.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CMP_ID=

# Live "people online" counter (leave blank to hide the footer badge).
# Injected automatically by the Vercel Marketplace Upstash Redis integration.
# The Upstash-native names UPSTASH_REDIS_REST_URL / _TOKEN also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=
